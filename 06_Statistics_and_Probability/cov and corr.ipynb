    "import numpy as np\n",
    "study_hours = np.array([1, 2, 3, 4, 5, 6])\n",
    "marks = np.array([20, 35, 50, 60, 75, 90])\n",
    " \n",
    "covv=np.cov(study_hours,marks)\n",
    "corr=np.corrcoef(study_hours,marks)\n",
    "print(covv)\n",
    "print(corr)\n"
   ]
